# FireZAP API — copy this file to .env and fill in the values.
# Never commit your .env file.

# Admin key (dashboard and admin routes). At least 24 characters.
# Generate one with: openssl rand -base64 36
FZ_ADMIN_KEY=

# PostgreSQL password used by docker-compose.yml
POSTGRES_PASSWORD=

# When running without docker compose, point to your own PostgreSQL:
# DATABASE_URL=postgres://user:password@localhost:5432/firezap?sslmode=disable

HTTP_PORT=8080
# Public address of this server, e.g. https://api.example.com
PUBLIC_URL=
# Address of the web dashboard, e.g. https://panel.example.com — its "/" opens the dashboard.
# The dashboard is also always at <PUBLIC_URL>/dashboard/.
PANEL_URL=

# Minimum time between two messages from the same instance, in milliseconds.
SEND_MIN_INTERVAL_MS=1000
# Most messages one instance sends in any 60 seconds / 60 minutes (0 = no limit).
SEND_MAX_PER_MINUTE=30
SEND_MAX_PER_HOUR=600
# Most send requests waiting for their turn per instance; more are refused with 429.
SEND_QUEUE_MAX=50
# Daily limits (see "Sending limits" in the README). Empty = off.
# Most messages per day, by days since the number was linked; the last value holds from then on.
# Suggested for a new number: 20,40,80,160,320,640,1000
SEND_DAILY_SCHEDULE=
# Same, counting only first messages to private chats the number never talked to.
# Suggested: 5,10,20,40,60,80,100
SEND_NEW_CHAT_SCHEDULE=
# Failed sends in a row (refused, or number not on WhatsApp) that pause sending; 0 = never.
SEND_PAUSE_AFTER_FAILURES=5
SEND_PAUSE_MINUTES=15
# Time zone of the day used by the daily limits (midnight resets them).
# TZ=America/Sao_Paulo
# Webhook request timeout, in seconds.
WEBHOOK_TIMEOUT=10
# Hours that webhook events which could not be delivered are kept to be sent again (0 = drop).
WEBHOOK_FAILED_RETENTION_HOURS=72
# Allow webhooks to loopback and private networks (e.g. another container on the same Docker
# network). Keep false when other people can set webhooks on your server: with true, they could
# make it call into your internal network. Cloud metadata (169.254.169.254) is always blocked.
WEBHOOK_ALLOW_PRIVATE=false
# Largest file sent or downloaded, in MB (1 to 100). Files are held in memory while sent.
MEDIA_MAX_MB=16

# Dashboard language: en or pt-BR
DEFAULT_LANGUAGE=en
# debug, info, warn or error
LOG_LEVEL=info
