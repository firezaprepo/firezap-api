# FireZAP API — copy this file to .env and fill in the values.
# Never commit your .env file.

# Admin key (dashboard and admin routes). At least 24 characters.
# Generate one with: openssl rand -base64 36
FZ_ADMIN_KEY=

# PostgreSQL password used by docker-compose.yml
POSTGRES_PASSWORD=

# When running without docker compose, point to your own PostgreSQL:
# DATABASE_URL=postgres://user:password@localhost:5432/firezap?sslmode=disable

HTTP_PORT=8080
# Public address of this server (used in media links), e.g. https://api.example.com
PUBLIC_URL=

# Minimum time between two messages from the same instance, in milliseconds.
SEND_MIN_INTERVAL_MS=1000
# Webhook request timeout, in seconds.
WEBHOOK_TIMEOUT=10

# Dashboard language: en or pt-BR
DEFAULT_LANGUAGE=en
# debug, info, warn or error
LOG_LEVEL=info
